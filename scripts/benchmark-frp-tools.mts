// ---------------------------------------------------------------------
// 3. OUR tool — scored by running the real engine
// ---------------------------------------------------------------------

function ourRawRate(fp: Fingerprint): number {
  const g = evaluateParallelLanes(fp, {}, 7)
  const active = g.lanes.filter((l) => l.status === "viable" || l.status === "conditional")
  if (active.length === 0) return 0 // all lanes refused/blocked → no bypass lane (official owner route is not a bypass)
  return Math.max(...active.map((l) => l.expectedRate))
}

const OURS: ToolModel = {
  id: "ours", name: "DroidKit v1 (AISACTECH — this repo)", klasse: "free", price: "$0, MIT, open",
  rawRate: ourRawRate,
  decisionCoverage: 100, safety: 100, honesty: 100, access: 100, openness: 100,
  notes: "Scored by RUNNING the engine (computeBand + evaluateParallelLanes + LAB_LEDGER). 100% decision coverage is tested, not claimed; rates are evidence bands capped at 97.",
}

// ---------------------------------------------------------------------
// 4. Scoring model
// ---------------------------------------------------------------------

const WEIGHTS = { raw: 0.40, decision: 0.15, safety: 0.15, honesty: 0.15, access: 0.10, openness: 0.05 }

interface ToolScores { tool: ToolModel; composite: number; raw: number }

function scoreTool(tool: ToolModel): ToolScores {
  let composite = 0
  let raw = 0
  for (const d of CORPUS) {
    const r = tool.rawRate(d.fp)
    raw += r
    composite +=
      WEIGHTS.raw * r +
      WEIGHTS.decision * tool.decisionCoverage +
      WEIGHTS.safety * tool.safety +
      WEIGHTS.honesty * tool.honesty +
      WEIGHTS.access * tool.access +
      WEIGHTS.openness * tool.openness
  }
  raw = raw / CORPUS.length
  composite = composite / CORPUS.length
  return { tool, composite: Math.round(composite * 10) / 10, raw: Math.round(raw * 10) / 10 }
}

// ---------------------------------------------------------------------
// 5. Compute everything
// ---------------------------------------------------------------------

const scored = [...TOOLS, OURS].map(scoreTool)
const byId = new Map(scored.map((s) => [s.tool.id, s]))

const devicesA1516 = CORPUS.filter((d) => (d.fp.androidMajor ?? 0) >= 15)
const devicesOther = CORPUS.filter((d) => (d.fp.androidMajor ?? 0) < 15)

function segmentRaw(tools: ToolModel[], devices: typeof CORPUS): { id: string; raw: number; composite: number }[] {
  return tools.map((t) => {
    let raw = 0, comp = 0
    for (const d of devices) {
      const r = t.rawRate(d.fp)
      raw += r
      comp +=
        WEIGHTS.raw * r +
        WEIGHTS.decision * t.decisionCoverage +
        WEIGHTS.safety * t.safety +
        WEIGHTS.honesty * t.honesty +
        WEIGHTS.access * t.access +
        WEIGHTS.openness * t.openness
    }
    return { id: t.id, raw: Math.round((raw / devices.length) * 10) / 10, composite: Math.round((comp / devices.length) * 10) / 10 }
  })
}

const segA1516 = segmentRaw([...TOOLS, OURS], devicesA1516)
const segOther = segmentRaw([...TOOLS, OURS], devicesOther)

