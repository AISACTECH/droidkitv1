const catRowsFinal = categories.map((c) => {
  const valueOf = (s: ToolScores): number =>
    c.key === "raw"
      ? s.raw
      : (s.tool as unknown as Record<string, number>)[c.key] ?? 0
  const sorted = [...scored].sort((a, b) => valueOf(b) - valueOf(a))
  const winner = sorted[0]
  const second = sorted[1]
  const winnerLabel = valueOf(winner) === valueOf(second) ? `${winner.tool.name} / ${second.tool.name} (tie)` : winner.tool.name
  return [c.label, winnerLabel, String(valueOf(winner)), valueOf(winner) === valueOf(second) ? "—" : second.tool.name]
