const BANNED = [
  /100%\s*(FRP|unlock|success)/i,
  /guaranteed\s*(FRP|unlock)/i,
  /outperform[s]?\s+(them|all|every)\s+in\s+everything/i,
  /works?\s+on\s+all\s+(modern\s+)?devices/i,
]

function table(header: string[], rows: (string | number)[][]): string {
  const h = `| ${header.join(" | ")} |`
  const sep = `| ${header.map(() => "---").join(" | ")} |`
  const body = rows.map((r) => `| ${r.join(" | ")} |`).join("\n")
  return `${h}\n${sep}\n${body}`
}

function pct(v: number): string { return v === 0 ? "—" : String(Math.round(v * 10) / 10) }

const toolOrder = [...TOOLS, OURS].map((t) => t.id)
const toolName = (id: string) => (byId.get(id) ?? (id === "ours" ? OURS : TOOLS.find((t) => t.id === id)!)).tool.name

const rawRows = CORPUS.map((d) => [
  d.id,
  ...toolOrder.map((id) => pct((byId.get(id) ?? OURS).tool.rawRate(d.fp))),
])

const compositeRows = CORPUS.map((d) => {
  const cells: (string | number)[] = [d.id]
  for (const id of toolOrder) {
    const t = (byId.get(id) ?? OURS).tool
    const r = t.rawRate(d.fp)
    const comp =
      WEIGHTS.raw * r +
      WEIGHTS.decision * t.decisionCoverage +
      WEIGHTS.safety * t.safety +
      WEIGHTS.honesty * t.honesty +
      WEIGHTS.access * t.access +
      WEIGHTS.openness * t.openness
    cells.push(Math.round(comp * 10) / 10)
  }
  return cells
})

