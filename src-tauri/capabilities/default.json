{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Production capability for main window with hardened permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-set-size",
    "core:window:allow-center",
    "opener:default",
    "opener:allow-open-url",
    "store:default",
    "store:allow-load",
    "store:allow-save",
    "store:allow-get",
    "store:allow-set",
    "store:allow-remove",
    "store:allow-clear"
  ]
}
