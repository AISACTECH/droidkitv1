interface ToolModel {
  id: string
  name: string
  klasse: "commercial" | "free" | "community"
  price: string
  rawRate: (fp: Fingerprint) => number
  decisionCoverage: number
  safety: number
  honesty: number
  access: number
  openness: number
  notes: string
}

const samsungOnly = (fp: Fingerprint) => fp.brand === "samsung"

const CHIPSET_ADJ: Record<string, { mtk: number; spd: number; exynos: number; qc: number }> = {
  samfw:    { mtk: 72, spd: 0,  exynos: 80, qc: 62 },
  fourukey: { mtk: 88, spd: 70, exynos: 90, qc: 80 },
  drfone:   { mtk: 85, spd: 65, exynos: 88, qc: 78 },
  imobie:   { mtk: 82, spd: 60, exynos: 85, qc: 72 },
  tsm:      { mtk: 90, spd: 80, exynos: 90, qc: 85 },
  unlockgo: { mtk: 80, spd: 55, exynos: 78, qc: 65 },
}

function chipsetRate(fp: Fingerprint, adj: { mtk: number; spd: number; exynos: number; qc: number }): number {
  switch (fp.chipsetFamily) {
    case "MediaTek": return adj.mtk
    case "Spreadtrum": return adj.spd
    case "Exynos": return adj.exynos
    case "Qualcomm": return adj.qc
    default: return 0
  }
}

function bandOf(fp: Fingerprint): FeasibilityBand {
  return computeBand(fp).band
}

function serverRoute(fp: Fingerprint, samsungRates: { a15: number; a16: number }, otherRate: number, gate: number): number {
  // Paid server/IMEI routes exist only on supported models (documented).
  if (fp.androidMajor === null || fp.androidMajor < 15) return 0
  if (fp.brand === "samsung") {
    return (fp.androidMajor === 15 ? samsungRates.a15 : samsungRates.a16) * gate
  }
  return otherRate * gate
}

