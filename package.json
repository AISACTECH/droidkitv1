{
  "name": "droidkit",
  "private": true,
  "version": "1.1.0",
  "description": "Enterprise-grade cross-platform Android toolkit — device management, FRP removal, system diagnostics, and developer utilities powered by Tauri + React",
  "author": {
    "name": "AISACTECH",
    "email": "support@droidkit.tech"
  },
  "license": "MIT",
  "type": "module",
  "keywords": [
    "android",
    "adb",
    "frp",
    "tauri",
    "rust",
    "react",
    "device-management",
    "developer-tools",
    "mobile"
  ],
  "homepage": "https://github.com/AISACTECH/droidkitv1#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/AISACTECH/droidkitv1.git"
  },
  "bugs": {
    "url": "https://github.com/AISACTECH/droidkitv1/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@10.9.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint": "tsc --noEmit",
    "lint:strict": "tsc --noEmit --strict",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" || echo 'prettier not installed, skipping'",
    "analyze": "vite build --mode analyze",
    "audit:prod": "node scripts/production-audit.js",
    "test:rescue": "node --experimental-strip-types scripts/verify-gesture-crack.mts",
    "test:nck": "node --experimental-strip-types scripts/verify-nck.mts",
    "test:lab": "node --experimental-strip-types scripts/verify-rescue-lab.mts",
    "test:core": "node --experimental-strip-types scripts/verify-core-lib.mts",
    "test:adaptive": "node --experimental-strip-types scripts/verify-adaptive-engine.mts",
    "test:research": "node --experimental-strip-types scripts/verify-parallel-research.mts",
    "refine:ui-flows": "node --experimental-strip-types scripts/refine-ui-flows.mts",
    "update:validate": "node --experimental-strip-types scripts/validate-update-pack.mts",
    "test:brands": "node --experimental-strip-types scripts/verify-brand-db.mts",
    "test:matrix": "node --experimental-strip-types scripts/verify-protocol-matrix.mts",
    "build:help-pdf": "node --experimental-strip-types scripts/build-help-pdf.mts",
    "simulate": "node scripts/simulate-large-scale.js",
    "simulate:market": "node scripts/simulate-market-comparison.js",
    "perf:report": "node scripts/perf-report.js",
    "simulate:devs": "node scripts/simulate-large-scale.js --devs=20000",
    "simulate:users": "node scripts/simulate-large-scale.js --users=20000",
    "simulate:full": "node scripts/simulate-large-scale.js --devs=20000 --users=20000",
    "postinstall": "echo 'DroidKit v1.1.0 installed. Run npm run tauri:dev for desktop or npm run dev for browser mock mode.'",
    "simulate:frp-mock": "node scripts/sim-harness.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jost": "^5.1.1",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.12",
    "@tanstack/react-query": "^5.85.3",
    "@tanstack/react-query-devtools": "^5.85.3",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-opener": "^2.2.1",
    "@tauri-apps/plugin-store": "^2.4.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.12",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^25.3.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "pdfkit": "^0.15.2",
    "tw-animate-css": "^1.3.6",
    "typescript": "~5.9.2",
    "vite": "^7.1.2"
  }
}
